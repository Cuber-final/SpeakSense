APP_ENV=dev
# Set APP_ENV=prod to enforce Redis-only behavior for rate-limit/idempotency controls.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/speakcoach
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=["*"]
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=*
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_MOCK_RESPONSE_TEXT=This is a mock model response.
# Optional compatibility aliases:
# MODEL_PROVIDER=mock
# MODEL_API_BASE=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
ENABLE_ASYNC_JOBS=false
JOB_QUEUE_NAME=default
JOB_TIMEOUT_SECONDS=300
JOB_INLINE_FALLBACK=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
ASR_PROVIDER=mock
ASR_DELETE_AUDIO_AFTER=true
ASR_MAX_DURATION_SECONDS=90
ASR_MOCK_TRANSCRIPT=This is a mock ASR transcript preview.
ASR_WHISPER_MODEL_SIZE=base
ASR_WHISPER_COMPUTE_TYPE=int8
# Used when ASR_PROVIDER is any OpenAI-compatible provider label (e.g. openai_compatible, zhipu)
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_MS=30000
ASR_MAX_RETRIES=1
JWT_SECRET=Mtv2tzNHi1Berehdcavayd6yt4aBq9yt
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120
DEV_ADMIN_USERNAME=dev_admin
DEV_ADMIN_PASSWORD=dev_admin_123456
DEV_ADMIN_ROLE=admin
