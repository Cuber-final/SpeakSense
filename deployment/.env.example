# Copy this file to deployment/.env and fill with your local values.

# Docker project
COMPOSE_PROJECT_NAME=speaksense-dev

# PostgreSQL
POSTGRES_DB=speakcoach
POSTGRES_USER=speakcoach
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-strong-password
REDIS_PORT=6379

# App connection strings (for backend/.env or local shell export)
# DATABASE_URL=postgresql+psycopg://speakcoach:change-me-strong-password@localhost:5432/speakcoach
# REDIS_URL=redis://:change-me-strong-password@localhost:6379/0
